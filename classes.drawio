<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Предметная область" id="gq-0enrIUIRlNABDQ3ks">
    <mxGraphModel dx="3179" dy="1739" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class User {\n        +int id\n        +str name\n        +str email\n        +update_profile(name, email)\n    }\n\n    class Customer {\n        -dict _purchased_books\n        +has_book(book_id) bool\n        +get_purchased_books() list\n        +add_purchased_book(book)\n    }\n\n    class Author {\n        +int id\n        +str name\n        +str biography\n        +update(name, biography)\n    }\n\n    class Publisher {\n        +int id\n        +str name\n        +update(name)\n    }\n\n    class Category {\n        +int id\n        +str name\n        +update(name)\n    }\n\n    class DigitalBook {\n        +int id\n        +str title\n        +Author author\n        +Publisher publisher\n        +Category category\n        +Decimal price\n        +str file_format\n        +str file_path\n        +update(title, price)\n    }\n\n    class Cart {\n        +Customer customer\n        -dict _items\n        +add_book(book)\n        +remove_book(book_id)\n        +get_items() list\n        +get_total() Decimal\n        +clear()\n    }\n\n    class CartItem {\n        +DigitalBook book\n        +get_price() Decimal\n    }\n\n    class Order {\n        +int id\n        +Customer customer\n        +str status\n        -list _items\n        +get_items() list\n        +get_total() Decimal\n        +mark_paid()\n        +cancel()\n    }\n\n    class OrderItem {\n        +DigitalBook book\n        +str book_title\n        +Decimal purchase_price\n    }\n\n    class Payment {\n        +int id\n        +Order order\n        +Decimal amount\n        +str status\n        +process(success) bool\n    }\n\n    class PurchaseLicense {\n        +int id\n        +Order order\n        +OrderItem item\n        +Customer customer\n        +DigitalBook book\n        +str issued_at\n        +get_file_path() str\n    }\n\n    User &lt;|-- Customer\n    Author \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : author\n    Publisher \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : publisher\n    Category \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : category\n\n    Customer \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Cart : customer\n    Cart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : items\n    CartItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DigitalBook : book\n\n    Customer \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; Order : customer\n    Order \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : items\n    OrderItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DigitalBook : book\n\n    Order \&quot;1\&quot; &lt;-- \&quot;0..1\&quot; Payment : order\n    Order \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PurchaseLicense : order\n    OrderItem \&quot;1\&quot; &lt;-- \&quot;0..1\&quot; PurchaseLicense : item\n    Customer \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PurchaseLicense : customer\n    DigitalBook \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; PurchaseLicense : book&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="W1XkOy_VP2Id8IRzry0N-105">
