        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class User {\n        +int id\n        +str name\n        +str email\n        +update_profile(name, email)\n    }\n\n    class Customer {\n        +get_purchased_books()\n        +has_book(book_id) bool\n    }\n\n    class Author {\n        +int id\n        +str name\n        +str biography\n        +update(name, biography)\n    }\n\n    class Publisher {\n        +int id\n        +str name\n        +update(name)\n    }\n\n    class Category {\n        +int id\n        +str name\n        +update(name)\n    }\n\n    class DigitalBook {\n        +int id\n        +str title\n        +Decimal price\n        +str file_format\n        +str file_path\n        +update(title, price)\n    }\n\n    class Cart {\n        +add_book(book)\n        +remove_book(book_id)\n        +get_total() Decimal\n        +clear()\n    }\n\n    class CartItem {\n        +DigitalBook book\n        +get_price() Decimal\n    }\n\n    class Order {\n        +int id\n        +str status\n        +get_total() Decimal\n        +mark_paid()\n        +cancel()\n    }\n\n    class OrderItem {\n        +DigitalBook book\n        +Decimal purchase_price\n    }\n\n    class Payment {\n        +int id\n        +Decimal amount\n        +str status\n        +process() bool\n    }\n\n    class PurchaseLicense {\n        +int id\n        +str issued_at\n        +get_file_path() str\n    }\n\n    User &lt;|-- Customer\n    Author \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : author\n    Publisher \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : publisher\n    Category \&quot;1\&quot; &lt;-- \&quot;0..*\&quot; DigitalBook : category\n    Customer \&quot;1\&quot; -- \&quot;1\&quot; Cart : owns\n    Cart \&quot;1\&quot; *-- \&quot;0..*\&quot; CartItem : items\n    CartItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DigitalBook : book\n    Customer \&quot;1\&quot; -- \&quot;0..*\&quot; Order : places\n    Order \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : items\n    OrderItem \&quot;0..*\&quot; --&gt; \&quot;1\&quot; DigitalBook : book\n    Order \&quot;1\&quot; -- \&quot;0..1\&quot; Payment : payment\n    Customer \&quot;1\&quot; -- \&quot;0..*\&quot; PurchaseLicense : owns\n    OrderItem \&quot;1\&quot; -- \&quot;0..1\&quot; PurchaseLicense : grants&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="W1XkOy_VP2Id8IRzry0N-1">
