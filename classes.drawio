  <diagram id="pSqyAV3HsEr0q3pMaGz5" name="Сервисы и хранение">
    <mxGraphModel dx="1049" dy="574" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class BookCatalog {\n        -dict _books\n        +add_book(book)\n        +get_book(book_id) DigitalBook\n        +list_books() list\n        +find_books(query) list\n        +update_book(book_id, title, price)\n        +remove_book(book_id)\n    }\n\n    class BookStore {\n        +BookCatalog catalog\n        -dict _customers\n        -dict _carts\n        -dict _orders\n        -dict _payments\n        -dict _licenses\n        -int _next_order_id\n        -int _next_payment_id\n        -int _next_license_id\n        +add_customer(customer)\n        +get_customer(customer_id)\n        +get_cart(customer_id)\n        +create_order(customer_id)\n        +get_order(order_id)\n        +list_orders(customer_id)\n        +pay_order(order_id, success) bool\n        +cancel_order(order_id)\n        +get_licenses(customer_id)\n    }\n\n    class ConsoleApp {\n        +BookStore store\n        +int customer_id\n        +show_menu()\n        +show_catalog()\n        +find_books()\n        +add_to_cart()\n        +show_cart()\n        +remove_from_cart()\n        +clear_cart()\n        +create_order()\n        +show_orders()\n        +pay_order()\n        +cancel_order()\n        +show_purchased_books()\n        +add_catalog_book()\n        +update_catalog_book()\n        +remove_catalog_book()\n        +run()\n    }\n\n    class SavedConsoleApp {\n        +JsonStoreStorage storage\n        +XmlStoreStorage xml_storage\n        +get_actions() dict\n        +show_menu()\n        +save_data()\n        +load_from(storage)\n        +load_data()\n        +export_xml()\n        +import_xml()\n        +run()\n    }\n\n    class CatalogCodec {\n        +to_dict(catalog) dict\n        +from_dict(data) BookCatalog\n        +read_id(record, key) int\n        +read_text(record, key) str\n        +read_records(data, key) list\n    }\n\n    class JsonCatalogStorage {\n        +Path file_path\n        +save(catalog)\n        +load() BookCatalog\n    }\n\n    class StoreCodec {\n        +to_dict(store) dict\n        +from_dict(data) BookStore\n        +read_money(record, key) Decimal\n    }\n\n    class JsonStoreStorage {\n        +Path file_path\n        +save(store)\n        +load() BookStore\n    }\n\n    class XmlStoreStorage {\n        +Path file_path\n        +encode_element(element, value)\n        +decode_element(element)\n        +save(store)\n        +load() BookStore\n    }\n\n    class BookStoreError {\n        Ошибка операции магазина\n    }\n\n    class Exception {\n        Встроенное исключение Python\n    }\n\n    class DigitalBook {\n        Класс на странице предметной области\n    }\n\n    ConsoleApp &lt;|-- SavedConsoleApp\n    Exception &lt;|-- BookStoreError\n\n    BookStore \&quot;1\&quot; *-- \&quot;1\&quot; BookCatalog : catalog\n    BookCatalog --&gt; DigitalBook : stores\n    ConsoleApp --&gt; BookStore : uses\n\n    SavedConsoleApp --&gt; JsonStoreStorage : storage\n    SavedConsoleApp *-- XmlStoreStorage : xml_storage\n\n    JsonCatalogStorage ..&gt; CatalogCodec : converts\n    CatalogCodec ..&gt; BookCatalog : restores\n\n    JsonStoreStorage ..&gt; StoreCodec : converts\n    XmlStoreStorage ..&gt; StoreCodec : converts\n    StoreCodec ..&gt; CatalogCodec : catalog\n    StoreCodec ..&gt; BookStore : restores\n\n    BookCatalog ..&gt; BookStoreError : raises\n    BookStore ..&gt; BookStoreError : raises\n    ConsoleApp ..&gt; BookStoreError : handles&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_VtuKZqW90kQRv9SrY7a-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
